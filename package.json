{
  "name": "gitnado",
  "version": "1.1.4",
  "description": "A fully-featured, open-source, cross-platform Git GUI client",
  "homepage": "https://gitnado.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/hegsie/gitnado.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "npm run test:contract && web-test-runner",
    "test:contract": "node --test scripts/ipc-contract.test.mjs scripts/menu-contract.test.mjs scripts/i18n-coverage.test.mjs scripts/security-lock.test.mjs scripts/ai-endpoint-contract.test.mjs scripts/icon-safe-area.test.mjs",
    "test:watch": "web-test-runner --watch",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint src e2e",
    "lint:fix": "eslint src e2e --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "localize:extract": "lit-localize extract",
    "localize:build": "lit-localize build",
    "icons:build": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@lit/localize": "^0.12.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lit": "^3.3.3",
    "shiki": "^4.6.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@lit/localize-tools": "^0.8.2",
    "@open-wc/testing": "^5.0.0",
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/test-runner": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright-core": "1.65.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "playwright": "1.64.1",
    "playwright-core": "1.65.0",
    "koa": ">=2.16.4",
    "esbuild": "^0.28.1",
    "ws@^7.0.0": "^7.5.11",
    "qs": ">=6.16.0",
    "@humanfs/node": ">=0.16.8",
    "zod": ">=4.6.6"
  }
}

{
  "name": "leviathan",
  "version": "0.8.0",
  "description": "A fully-featured, open-source, cross-platform Git GUI client",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "npm run test:contract && web-test-runner",
    "test:contract": "node --test scripts/ipc-contract.test.mjs scripts/menu-contract.test.mjs scripts/i18n-coverage.test.mjs scripts/security-lock.test.mjs",
    "test:watch": "web-test-runner --watch",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint src e2e",
    "lint:fix": "eslint src e2e --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "localize:extract": "lit-localize extract",
    "localize:build": "lit-localize build"
  },
  "dependencies": {
    "@lit/localize": "^0.12.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "~2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lit": "^3.3.3",
    "shiki": "^4.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@lit/localize-tools": "^0.8.2",
    "@open-wc/testing": "^5.0.0",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "playwright-core": "1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  },
  "overrides": {
    "playwright": "1.62.1",
    "playwright-core": "1.62.1",
    "koa": ">=2.16.4",
    "esbuild": "^0.28.1",
    "ws@^7.0.0": "^7.5.11",
    "qs": ">=6.16.0",
    "@humanfs/node": ">=0.16.8"
  }
}
